<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LustPad.App"
             xmlns:local="using:LustPad"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Locked accent: sliders/knobs follow this, not Windows personalization. -->
                <ColorPaletteResources x:Key="Dark" Accent="#7C3AED" />
                <ColorPaletteResources x:Key="Light" Accent="#7C3AED" />
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>